    "addExchangeSchema({ exchangeName, getCandles, ... })",
    "addFrameSchema({ frameName, interval, startDate, endDate })",
    "listenIdlePing(callback)",
    "listenActivePing(callback)",
    "commitCreateSignal(symbol, dto)",
    "commitClosePending(symbol, opts?)",
    "commitBreakeven(symbol)",
    "commitSignalNotify(symbol, opts)",
