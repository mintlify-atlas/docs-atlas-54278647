  "keyFeatures": [
    "LLM-driven Telegram signal parsing (text + chart screenshots) via json-inference tool-grammar",
    "Zero look-ahead bias backtesting over 1-minute OHLCV candles with backtest-kit",
    "Level-ratchet trailing stop derived from signal grid geometry, not fitted to PnL",
    "Dual-pipeline event-driven strategy for channels where entry and exit are separate posts",
    "Event study toolkit measuring directional edge at +15m/+1h/+4h/+12h/+24h horizons",
    "Prompt regression suite (validate.mjs) that exits non-zero on any parsing failure",
    "Deterministic numeric extraction via Ollama tool-call grammar despite non-deterministic reasoning",
    "Vision support — base64 JPEG post images sent directly to the model for chart/position-card reading"
  ],
  "publicApiSurface": [
